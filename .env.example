# Safe defaults: all background work, WhatsApp crypto-related messaging, and live trading are off.
APP_ENV=development
# Set DATABASE_URL on Render to the private Postgres connection string; blank uses local SQLite.
DATABASE_URL=
DATABASE_PATH=./data/mexc_bot.sqlite3
REPORTS_DIR=./reports
MEXC_REST_BASE_URL=https://api.mexc.com
MEXC_PRICE_SERIES=standard
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_RETRIES=3
CANDLE_CLOSE_GRACE_SECONDS=5
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
PAPER_TRADING_ENABLED=false
DATA_ALIGNMENT_PROBE_APPROVED=false
AUTO_TRADING_ENABLED=false
LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_BUILD_RELEASED=false

# Strategy defaults (research hypothesis only; not validated for profitability)
DEFAULT_SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT
STRATEGY_VERSION=RSI-EMA-3M-LONG-v1
RISK_PER_TRADE_FRACTION=0.005
MAX_OPEN_RISK_FRACTION=0.02
MAX_DRAWDOWN_FRACTION=0.10
MAX_DAILY_LOSS_FRACTION=0.02
MAX_CONCURRENT_POSITIONS=1
INITIAL_MARGIN_USDT=1.00
MAX_LEVERAGE=50
NET_TAKE_PROFIT_USDT=0.30
REQUESTED_STOP_LOSS_USDT=3.00
STRATEGY_TIMEFRAME=3M
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_VOLUME_PERIOD=20
RSI_VOLUME_MULTIPLIER=1.2
EMA_FAST=21
EMA_MID=50
EMA_SLOW=100
EMA_CHART_PERIODS=21,50,100,200

# Backtest modes; the fixed-payout model is hypothetical and not exchange P&L.
FIXED_TP_PCT=5.0
FIXED_SL_PCT=2.0
FIXED_WIN_PAYOUT=20.0
FIXED_LOSS_PAYOUT=5.0
DEFAULT_STARTING_BALANCE=100.0
EXCHANGE_TAKER_FEE_RATE=0.0008
EXCHANGE_MAKER_FEE_RATE=0.0006
BACKTEST_SLIPPAGE_BPS_PER_SIDE=5.0
BACKTEST_COST_STRESS_MULTIPLIERS=1.0,1.5,2.0

# WhatsApp is blocked for crypto-specific content by default. Do not enable unless written
# Meta policy clearance explicitly covers this exact private/automated use case.
WHATSAPP_CRYPTO_MESSAGING_ALLOWED=false
WHATSAPP_POLICY_CLEARANCE_REF=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_MONTHLY_MESSAGE_CAP=900

# Paper mode simulates signals and exits; it never sends orders.
# Enable only after reviewing the paper strategy and its logs.
# PAPER_TRADING_ENABLED=false

# Never set these true merely because API credentials exist.
MEXC_API_KEY=
MEXC_API_SECRET=

# Required for the authenticated read-only dashboard; use a unique strong secret.
WEB_API_TOKEN=
