# App
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_PATH=/var/data/btc_mexc_bot.sqlite3
MONITOR_ENABLED=true

# MEXC public market data (no private API keys; no order permissions)
MEXC_BASE_URL=https://api.mexc.com
MEXC_SYMBOL=BTC_USDT
MEXC_INTERVAL=Min1
MEXC_TIMEOUT_SECONDS=15
MEXC_MAX_RETRIES=4

# Strategy (closed 1-minute candles only)
EMA_FAST=6
EMA_MID=12
EMA_SLOW=21
LIVE_RSI_PERIOD=9
LIVE_RSI_UPPER=65
LIVE_RSI_LOWER=35
WARMUP_CANDLES=120
LIVE_TP_MOVE_PCT=0.50

# Signal safety — proposed starting thresholds
ABNORMAL_5M_MOVE_PCT=1.00
ABNORMAL_1M_RANGE_PCT=0.60
RECOVERY_5M_MOVE_PCT=0.50
RECOVERY_MINUTES=15
SIGNAL_EXPIRY_DEVIATION_PCT=0.20

# Research sizing only (never used to place orders)
STARTING_BALANCE_USDT=100
MAX_MARGIN_USDT=0.50
MODEL_LEVERAGE=200
BACKTEST_TAKER_FEE_RATE=0.0008
BACKTEST_SLIPPAGE_TICKS=1
BACKTEST_TP_PCTS=0.50,0.75,1.00

# WhatsApp Cloud API credentials — configure only in Render environment settings
GRAPH_API_VERSION=v26.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_RECIPIENTS=
AUTHORIZED_WA_IDS=
