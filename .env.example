# v0.8.4 S1-RFPC research build. Copy to .env for local development.
# Safe local defaults: scanner, paper trading, automated crypto WhatsApp delivery and live trading are OFF.
APP_ENV=development
APP_ROLE=web

# Storage. Render web + worker MUST share the same DATABASE_URL (Render Blueprint wires this).
# Leave DATABASE_URL blank for local SQLite. Never commit production credentials.
DATABASE_URL=
DATABASE_PATH=./data/mexc_bot.sqlite3
REPORTS_DIR=./reports
MARKET_DATA_DIR=./data/market

# Public-only MEXC Futures REST access. No authenticated order endpoint is implemented.
MEXC_REST_BASE_URL=https://api.mexc.com
MEXC_PRICE_SERIES=standard
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_RETRIES=3
CANDLE_CLOSE_GRACE_SECONDS=5

# Dedicated worker cadence. Backtest queue polling is independent of the slower scan cycle.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
BACKTEST_JOB_POLL_SECONDS=5
MEXC_UNIVERSE_TOP_N=100
MEXC_UNIVERSE_SCAN_ENABLED=false
SIGNAL_PUSH_ENABLED=false
SIGNAL_TTL_BARS=2
SIGNAL_MIN_SCORE=65
SIGNAL_PUSH_MIN_SCORE=80

# Active strategy: completed 1D -> 12H -> 4H -> 1H only.
STRATEGY_VERSION=S1-RFPC-0.2.0-1H-trigger
DEFAULT_SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT
MTF_HTF_WARMUP_BARS=250
CANDIDATE_STOP_ATR_MULTIPLE=1.5
CANDIDATE_TARGET_ATR_MULTIPLE=2.5
CANDIDATE_MIN_NET_RR=1.2
BACKTEST_MIN_COVERAGE_PCT=98
BACKTEST_MIN_UNIVERSE_COVERAGE_PCT=90
LIVE_MAX_SPREAD_ATR_FRACTION=0.10
LIVE_MIN_ORDERBOOK_DEPTH_USDT=250
MAX_ADVERSE_FUNDING_RATE=0.0005

# Risk controls: 50-position cap applies ONLY to research backtests. Paper remains at one.
RISK_PER_TRADE_FRACTION=0.005
BACKTEST_MAX_POSITIONS=50
BACKTEST_MAX_OPEN_RISK_FRACTION=0.25
BACKTEST_MAX_TOTAL_NOTIONAL_MULTIPLE=25
BACKTEST_LIQUIDATION_FEE_RATE=0
MAX_OPEN_RISK_FRACTION=0.02
MAX_DRAWDOWN_FRACTION=0.10
MAX_DAILY_LOSS_FRACTION=0.02
MAX_CONCURRENT_POSITIONS=1
DEFAULT_STARTING_BALANCE=100
INITIAL_MARGIN_USDT=1
MAX_LEVERAGE=50
NET_TAKE_PROFIT_USDT=0.30
REQUESTED_STOP_LOSS_USDT=3.00
BACKTEST_MARGIN_MODE=cross
BACKTEST_MAX_HOLDING_MINUTES=1440

# Legacy indicator settings are retained for chart/legacy compatibility only; they do not define S1-RFPC.
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
EMA_FAST=21
EMA_MID=50
EMA_SLOW=100
RSI_VOLUME_PERIOD=20
RSI_VOLUME_MULTIPLIER=1.2

# Modeled costs. They are estimates, not confirmed fills or full order-book replay.
EXCHANGE_TAKER_FEE_RATE=0.0008
EXCHANGE_MAKER_FEE_RATE=0.0006
BACKTEST_SLIPPAGE_BPS_PER_SIDE=5
BACKTEST_COST_STRESS_MULTIPLIERS=1.0,1.5,2.0
FIXED_TP_PCT=5
FIXED_SL_PCT=2
FIXED_WIN_PAYOUT=20
FIXED_LOSS_PAYOUT=5

# Safety gates. Keep live execution and paper mode off; this build has no live order-placement path.
PAPER_TRADING_ENABLED=false
DATA_ALIGNMENT_PROBE_APPROVED=false
AUTO_TRADING_ENABLED=false
LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_BUILD_RELEASED=false

# WhatsApp crypto research notifications are gated. Do not enable without written clearance
# applicable to this exact business use and valid recipient/Meta configuration.
WHATSAPP_CRYPTO_MESSAGING_ALLOWED=false
WHATSAPP_POLICY_CLEARANCE_REF=
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_MONTHLY_MESSAGE_CAP=900
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WEB_API_TOKEN=

# No MEXC API credentials are needed for the public-only research endpoints.
MEXC_API_KEY=
MEXC_API_SECRET=
