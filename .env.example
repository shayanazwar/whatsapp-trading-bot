# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./rslr.db

# MEXC public market data. No key required for public endpoints.
MEXC_BASE_URL=https://api.mexc.com
MEXC_TIMEOUT_SECONDS=12
MEXC_MAX_RETRIES=3
UNIVERSE_SIZE=25
MIN_24H_QUOTE_VOLUME=1000000

# Strategy / timeframe configuration (only 1D,12H,4H,1H are supported)
ENABLE_SWEEP=true
ENABLE_DONCHIAN=true
ACCOUNT_EQUITY_USD=100
RISK_PER_TRADE=0.005
TAKER_FEE_RATE=0.0008
SLIPPAGE_RATE=0.0005
DEFAULT_LEVERAGE=2
MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=3
MAX_MARGIN_FRACTION=0.25
MAX_HOLD_HOURS=72

# Signal anti-spam
MAX_SIGNALS_PER_SCAN=3
MAX_SIGNALS_PER_24H=8
SAME_SYMBOL_COOLDOWN_HOURS=4
SCAN_INTERVAL_SECONDS=3600

# WhatsApp Cloud API. Empty values keep webhook integration inactive.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_SIGNAL_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Hard safety locks. These cannot be overridden by environment variables.
AUTO_TRADING_ENABLED=false
LIVE_EXECUTION_ENABLED=false
PAPER_TRADING_ENABLED=true
