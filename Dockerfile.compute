FROM python:3.11-slim
ARG KRONOS_REVISION=67b630e67f6a18c9e9be918d9b4337c960db1e9a
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/var/data/huggingface TRANSFORMERS_CACHE=/var/data/huggingface
WORKDIR /srv/app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY app/ ./app/
COPY alembic.ini ./alembic.ini
COPY alembic/ ./alembic/
COPY scripts/ ./scripts/
RUN pip install '.[inference]' && mkdir -p third_party && \
    git clone --filter=blob:none https://github.com/shiyu-coder/Kronos.git third_party/Kronos && \
    git -C third_party/Kronos checkout --detach "${KRONOS_REVISION}" && \
    test "$(git -C third_party/Kronos rev-parse HEAD)" = "${KRONOS_REVISION}"
CMD ["sh", "-c", "python -m app.migration_lock && python -m app.worker --role compute"]
