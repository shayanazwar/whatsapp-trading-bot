# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-password
SESSION_MAX_AGE_SECONDS=43200

# Research-only safety interlocks. Changing these from the safe values blocks startup.
PAPER_MODE=true
LIVE_TRADING_ENABLED=false
AUTOMATIC_ORDER_EXECUTION=false

# Database: SQLite for local development; Render injects PostgreSQL URL in production
DATABASE_URL=sqlite:///./data/kronos_intelligence.db

# MEXC public Futures API — no private API credentials or order permissions are used
MEXC_API_BASE_URL=https://api.mexc.com
MEXC_WS_URL=wss://contract.mexc.com/edge
MEXC_HTTP_TIMEOUT=15
MEXC_MAX_RETRIES=3
MEXC_REQUEST_MIN_INTERVAL_SECONDS=0.11

# Scanning and research
AUTO_SCAN_ENABLED=true
MARKET_SCAN_INTERVAL_SECONDS=3600
UNIVERSE_LIMIT=30
MIN_24H_TURNOVER_USDT=1000000
MAX_SPREAD_BPS=15
MIN_NET_RR=1.5
DEFAULT_ACCOUNT_EQUITY=1000
RISK_PER_TRADE_PCT=0.5
MAX_PORTFOLIO_RISK_PCT=3.0
DEFAULT_LEVERAGE=2

# Kronos — pinned revisions. Small model/tokenizer are both MIT per their model cards.
KRONOS_REPO_URL=https://github.com/shiyu-coder/Kronos.git
KRONOS_REPO_REVISION=67b630e67f6a18c9e9be918d9b4337c960db1e9a
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_MODEL_REVISION=901c26c1332695a2a8f243eb2f37243a37bea320
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_TOKENIZER_REVISION=f6c7de7b0490e422fde7a44bc73369e07115c445
KRONOS_DEVICE=auto
KRONOS_CONTEXT_LENGTH=512
FORECAST_SAMPLE_COUNT=1000
FORECAST_HORIZON=24
FORECAST_CHUNK_SIZE=16
FORECAST_TEMPERATURE=1.0
FORECAST_TOP_P=0.9
FORECAST_RANDOM_SEED=42

# Backtesting / simulation
SIMULATION_REPLAYS=10000
SIMULATION_BLOCK_LENGTH=4
BACKTEST_MAX_DAYS=180
BACKTEST_DEFAULT_EQUITY=1000
BACKTEST_RISK_PER_TRADE_PCT=0.5
BACKTEST_TAKER_FEE_RATE=
BACKTEST_MAKER_FEE_RATE=
BACKTEST_SLIPPAGE_BPS=3

# Workers
WORKER_ROLE=all
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=900

# Forecast artifacts are gzip-compressed and stored in PostgreSQL in this release.

# WhatsApp crypto-futures signal delivery is blocked by Meta policy; no credentials are collected.
