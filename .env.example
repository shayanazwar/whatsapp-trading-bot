# Meta / WhatsApp Cloud API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
ALLOWED_USERS=

# Telegram Bot API (optional; enables a second messaging channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Runtime
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=signals.db
ALERT_CHECK_SECONDS=0.75
MARKET_CACHE_RETRY_SECONDS=5
DISCOVERY_REFRESH_SECONDS=900
CHART_DEFAULT_BARS=180
FORCE_UTC=true

# MEXC Futures - keep secrets only in Render/environment variables
MEXC_API_BASE_URL=https://api.mexc.com
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=
MEXC_RECV_WINDOW=10
MEXC_ORDER_TYPE=1
MEXC_OPEN_TYPE=1
MEXC_DEFAULT_LEVERAGE=3

# Initial risk/testing configuration
MAX_RISK_PER_TRADE=1.0
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=0.05

# Automation switches - keep live execution OFF until validated
SCANNER_ENABLED=false
AUTO_SIGNAL_ENABLED=false
AUTO_TRADE_ENABLED=false
ALLOW_LIVE_EXECUTION=false
SCAN_INTERVAL_SECONDS=300
MAX_SYMBOLS=120
SCAN_CONCURRENCY=4
# Conservative shared public-request pacing; MEXC may impose additional limits.
MEXC_PUBLIC_MIN_INTERVAL_SECONDS=0.20
MEXC_PUBLIC_WINDOW_SECONDS=2.0
MEXC_PUBLIC_WINDOW_LIMIT=8
MEXC_RATE_LIMIT_MAX_RETRIES=4
MEXC_RATE_LIMIT_BACKOFF_SECONDS=2.0
MEXC_RATE_LIMIT_BACKOFF_CAP_SECONDS=20.0
MEXC_RATE_LIMIT_JITTER_SECONDS=0.25
CANDLE_LIMIT=250
MIN_CONFLUENCE=82
MIN_RR=2.0
MAX_ENTRY_DRIFT_PCT=0.002
REQUIRE_INCREASING_VOLUME=false
SIGNAL_EXPIRY_MINUTES=30
AUTO_SIGNAL_RECIPIENTS=
AUTO_SIGNAL_TELEGRAM_RECIPIENTS=
TEST_SYMBOLS=
# Phase 2 MEXC execution-quality filters
MAX_MEXC_SPREAD_PCT=0.001
MAX_INDEX_DISLOCATION_PCT=0.002
MAX_DATA_AGE_SECONDS=5
ORDERBOOK_LEVELS=10
TRADE_FLOW_LIMIT=100

MAX_SIGNAL_AGE_SECONDS=330
